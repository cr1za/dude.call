<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="0dp">
    <!-- Widget background is fully transparent; only the red/black arcade-button pixels are visible. -->
    <ImageView
        android:id="@+id/widget_red_button"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/widget_button_label"
        android:background="@android:color/transparent"
        android:src="@drawable/widget_arcade_button"
        android:scaleType="fitCenter" />
</FrameLayout>
